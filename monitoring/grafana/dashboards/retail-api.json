{
  "uid": "ban6800-api",
  "title": "BAN6800 live API telemetry",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "timezone": "utc",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API scrape health",
      "gridPos": {"h": 5, "w": 8, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "retail-prometheus"},
      "targets": [{"expr": "up{job=\"retail-api\"}", "refId": "A"}]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Prediction requests per second by status",
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 0},
      "datasource": {"type": "prometheus", "uid": "retail-prometheus"},
      "targets": [{"expr": "sum by (status) (rate(ban6800_predict_requests_total[5m]))", "legendFormat": "{{status}}", "refId": "A"}]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Prediction route p95 latency in seconds",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "retail-prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(ban6800_predict_seconds_bucket[5m])))", "refId": "A"}]
    },
    {
      "id": 4,
      "type": "text",
      "title": "Evidence boundaries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "options": {"mode": "markdown", "content": "Live telemetry measures API activity, availability and latency. No new sales labels are connected, so new forecast error and group-bias drift are unavailable. Historical 2016 accuracy and group findings, plus live input distribution checks, are shown at the API /monitoring page. Local Prometheus retains scrapes in its volume for 30 days. Do not scrape the sleeping public Render demo continuously to defeat free-tier idling."}
    }
  ]
}
